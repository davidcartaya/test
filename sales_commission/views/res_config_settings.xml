<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_sales_config_inherit_commission" model="ir.ui.view">
			<field name="name">res.config.settings.sale.inh</field>
			<field name="model">res.config.settings</field>
			<field name="inherit_id" ref="sale.res_config_settings_view_form"/>
			<field name="arch" type="xml">
				<xpath expr="//div[hasclass('settings')]/div[@data-key='sale_management']" position="inside">
					<h2 groups="sales_commission.group_commission_user">Configuración de Comisión</h2>
					<div groups="sales_commission.group_commission_user" class="row mt16 o_settings_container">
						<div class="col-xs-12 col-md-6 o_setting_box">
							<div class="o_setting_left_pane">
							</div>
							<div class="o_setting_right_pane">
								<label for="commission_configuration" string="Pagar Comisión Basado en"/>
								
								<div class="mt16">
									<field name="commission_configuration" widget="radio"/>
								</div>
							</div>
						</div>
						<div class="col-xs-12 col-md-6 o_setting_box">
							<div class="o_setting_left_pane">
							</div>
							<div class="o_setting_right_pane">
								<label for="commission_calc_on" string="Cálculo de Comisión Basado en"/>
								<!-- <div class="text-muted">
									Si se selecciona "Basado en Pago", no se permite el cálculo directo para "Producto" ni "Categoría de Producto".
	   							</div> -->
								<div class="mt16">
									<field name="commission_calc_on" widget="radio"/>
								</div>
							</div>
						</div>

					</div>
					
				</xpath>
			</field>
		</record>

    </data>
</odoo>
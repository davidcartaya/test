<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>

		<record id="product_template_only_form_view_inh" model="ir.ui.view">
			<field name="name">product.template.form.inh</field>
			<field name="model">product.template</field>
			<field name="inherit_id" ref="product.product_template_only_form_view"/>
			<field name="arch" type="xml">
				<xpath groups="sales_commission.group_commission_user" expr="//form/sheet/div[3]/span[2]" position="after">
					<div groups="sales_commission.group_commission_user">
						<field name="is_commission_product"/>
						<label for="is_commission_product" string="Producto de Comisión"/>
					</div>
				</xpath>
				<xpath expr="//form/sheet/notebook" position="inside">
					<page groups="sales_commission.group_commission_user" string="Configuración de Comisión">
						<div groups="sales_commission.group_commission_user">
							<label for="commission_type" string="Tipo de Comisión"/>
							<field name="commission_type"/>

							<label for="amount_comission" string="Monto o porcentaje de Comisión"/>
							<field name="amount_comission"/>

							<label for="commission_assignment" string="Asignación de Comisión"/>
							<field name="commission_assignment"/>
						</div>
					   	<field name="commission_ids">
							<tree editable="bottom">
								<field name="employee_id"/>
								<field name="commission_type"/>
								<field name="amount"/>
								<field name="product_id" invisible="1"/>
							</tree>
					   </field>
					</page>
				</xpath>
			</field>
		</record>

	</data>
</odoo>
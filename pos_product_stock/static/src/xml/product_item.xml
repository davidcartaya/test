<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
      <!-- Inherited ProductItem to add field. -->
    <t t-name="ProductItem" t-inherit="point_of_sale.ProductItem" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[hasclass('product-content')]" position="replace">
                <div class="product-content">
                    <div t-attf-class="#{props.product.image_128 ? 'product-name' : 'product-name no-image' }" t-attf-id="article_product_{{props.product.id}}">
                        <t t-esc="props.product.display_name" />
                    </div>
                    <div class="content-price-qty">
                        <span class="price-tag">
                            <t t-esc="price" />
                        </span>
                        <t t-if="value.display_stock_setting==true">
                            <t t-if="env.pos.config['location_from']=='all_warehouse'">
                                <t t-if="env.pos.config['stock_product'] == 'incoming_qty'">
                                    <div t-attf-class="#{props.product.virtual_stock &lt;= 0 0 ? 'ribbon-wrapper out-of-stock' : 'ribbon-wrapper' }">
                                        <div class="ribbon">
                                            <t t-esc="props.product.virtual_stock"/>
                                        </div>
                                    </div>
                                </t>
                                <t t-if="env.pos.config['stock_product']=='outgoing_qty'">
                                    <div t-attf-class="#{props.product.virtual_stock &lt;= 0 ? 'ribbon-wrapper out-of-stock' : 'ribbon-wrapper' }">
                                        <div class="ribbon"><t t-esc="props.product.virtual_stock"/></div>
                                    </div>
                                </t>
                                <t t-if="env.pos.config['stock_product']=='on_hand'">
                                    <div t-attf-class="#{props.product.virtual_stock &lt;= 0 ? 'ribbon-wrapper out-of-stock' : 'ribbon-wrapper' }">
                                        <div class="ribbon"><t t-esc="props.product.virtual_stock"/></div>
                                    </div>
                                </t>
                                <t t-if="env.pos.config['stock_product']=='available_qty'">
                                    <div t-attf-class="#{props.product.virtual_stock ? 'ribbon-wrapper out-of-stock' : 'ribbon-wrapper' }">
                                        <div class="ribbon"><t t-esc="props.product.virtual_stock"/></div>
                                    </div>
                                </t>
                            </t>
                            <t t-else="env.pos.config['location_from']=='current_warehouse'">
                                <t t-if="env.pos.config['stock_product']=='incoming_qty'">
                                    <div t-attf-class="#{props.product.virtual_stock &lt;= 0 ? 'ribbon-wrapper out-of-stock' : 'ribbon-wrapper' }">
                                        <div class="ribbon"><t t-esc="props.product.virtual_stock"/></div>
                                    </div>
                                </t>
                                <t t-if="env.pos.config['stock_product']=='outgoing_qty'">
                                    <div t-attf-class="#{props.product.virtual_stock &lt;= 0 ? 'ribbon-wrapper out-of-stock' : 'ribbon-wrapper' }">
                                        <div class="ribbon"><t t-esc="props.product.virtual_stock"/></div>
                                    </div>
                                </t>
                                <t t-if="env.pos.config['stock_product']=='on_hand'">
                                    <div t-attf-class="#{props.product.virtual_stock &lt;= 0 ? 'ribbon-wrapper out-of-stock' : 'ribbon-wrapper' }">
                                        <div class="ribbon"><t t-esc="props.product.virtual_stock"/></div>
                                    </div>
                                </t>
                                <t t-if="env.pos.config['stock_product']=='available_qty'">
                                    <div t-attf-class="#{props.product.virtual_stock &lt;= 0 ? 'ribbon-wrapper out-of-stock' : 'ribbon-wrapper' }">
                                        <div class="ribbon"><t t-esc="props.product.virtual_stock"/></div>
                                    </div>
                                </t>
                            </t>
                        </t>
                    </div>
                </div>
        </xpath>
   </t>
</templates>